  {
    "vo": "hall_01",
    "speaker": "narrateur",
    "text": "马克在北京机场。"
  },
  {
    "vo": "hall_02",
    "speaker": "narrateur",
    "text": "他不在法国，他在中国。"
  },
  {
    "vo": "hall_03",
    "speaker": "narrateur",
    "text": "马克找行李。"
  },
  {
    "vo": "hall_04a",
    "speaker": "player",
    "text": "请问，行李在哪儿?"
  },
  {
    "vo": "hall_04b",
    "speaker": "player",
    "text": "请问，行李在那儿?"
  },
  {
    "vo": "hall_04c",
    "speaker": "player",
    "text": "请问，行李哪儿在?"
  },
  {
    "vo": "hall_05",
